# Copy this file to .env.local and fill in the values. .env.local is never committed.
# All five are required: the app shows a setup page listing any that are missing.

# Backend base URL, no trailing slash. Local backend: http://localhost:3000
VITE_API_URL=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Web API key of the Firebase project.
VITE_FIREBASE_API_KEY=
# Auth domain, usually <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase project id. Must be the same project the backend verifies tokens against.
VITE_FIREBASE_PROJECT_ID=
# Firebase web app id (1:...:web:...).
VITE_FIREBASE_APP_ID=
